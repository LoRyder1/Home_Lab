
// Prevent future indices from creting replicas

sudo so-elasticsearch-query _template/zero_replicas -X PUT -H 'Content-Type: application/json' -d '{
  "index_patterns": ["*"],
  "settings": {
    "number_of_replicas": 0
  }
}'

sudo so-elasticsearch-query _template/zero_replicas -X PUT -d '{
  "index_patterns": ["*"],
  "settings": {
    "number_of_replicas": 0
  }
}'


